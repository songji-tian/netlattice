# Public hostname or IP peers use to reach WireGuard.
WG_HOST=vpn.example.com

# bcrypt hash of the wg-easy admin password. Generate it, do not store plaintext.
# Single quotes keep the $ characters literal for Docker Compose.
WG_ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'

# DNS server peers should use (the DNS module).
WG_DEFAULT_DNS=192.168.10.2

# Narrow this to your LAN and VPN CIDRs.
WG_ALLOWED_IPS=192.168.10.0/24,10.44.0.0/24

# Bind the wg-easy admin UI. Keep localhost unless you need LAN/VPN access.
VPN_ADMIN_BIND=127.0.0.1
